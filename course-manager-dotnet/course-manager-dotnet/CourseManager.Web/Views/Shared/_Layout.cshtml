<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Course Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Courses" asp-action="Index">Course Manager</a>
        <div class="navbar-nav ms-auto flex-row gap-3">
            <a class="nav-link" asp-controller="Courses" asp-action="Index">Khóa học</a>
            <a class="nav-link" asp-controller="Categories" asp-action="Index">Loại khóa học</a>
        </div>
    </div>
</nav>
<div class="container mt-3">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show">@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }
</div>
<main class="container py-3">@RenderBody()</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
